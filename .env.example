# NSS VIIT (A) — Environment Variable Template
#
# Copy this file to .env and fill in real values.
# .env is listed in .gitignore and must NEVER be committed.
#
# ─────────────────────────────────────────────────────────────────
# SECURITY RULES
# ─────────────────────────────────────────────────────────────────
# - VITE_ prefixed variables are bundled into the browser build.
#   Only the Supabase anon/public key belongs here.
# - The service-role key MUST NOT appear in any VITE_ variable.
#   It must only be used in server-side/edge function environments.
# - Rotate all keys immediately if they are exposed.
# ─────────────────────────────────────────────────────────────────

# ── Supabase (client-side — anon/public key only) ─────────────────
# These values come from your Supabase project → Settings → API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Application metadata ──────────────────────────────────────────
VITE_APP_NAME=NSS VIIT (A)
VITE_APP_INSTITUTION=Vignan's Institute of Information Technology (Autonomous)
VITE_APP_ENV=development

# ── Feature flags (all features disabled during development) ──────
# Registration stays disabled until a separate authorized decision.
# See PRD §6.1 and Implementation Plan §10.
VITE_REGISTRATION_ENABLED=false

# ─────────────────────────────────────────────────────────────────
# SERVER-SIDE ONLY VARIABLES (edge functions / deployment secrets)
# ─────────────────────────────────────────────────────────────────
# The following are NEVER prefixed with VITE_ and must never
# appear in browser-bundled code.
#
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# EMAIL_PROVIDER_API_KEY=your-email-api-key-here
# SUPABASE_DB_PASSWORD=your-db-password-here
