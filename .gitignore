# ── Build output ─────────────────────────────────────────────────
dist/
dist-ssr/
*.local

# ── Dependencies ──────────────────────────────────────────────────
node_modules/

# ── Environment and secrets ───────────────────────────────────────
# NEVER commit real credentials.
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production
.env.staging

# ── Supabase local ────────────────────────────────────────────────
# Supabase CLI local config and generated types (re-generate on pull).
.supabase/
supabase/.branches/
supabase/.temp/

# ── Logs ─────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Test and coverage ────────────────────────────────────────────
coverage/
.nyc_output/

# ── TypeScript incremental cache ──────────────────────────────────
*.tsbuildinfo

# ── OS artifacts ─────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Editor artifacts ──────────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo

# ── Misc ─────────────────────────────────────────────────────────
*.pem

# ── Python artifacts ─────────────────────────────────────────────
__pycache__/
*.py[cod]
